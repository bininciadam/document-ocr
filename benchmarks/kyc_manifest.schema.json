{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/piyush-gambhir/document-ocr/benchmarks/kyc_manifest.schema.json",
  "title": "Private KYC OCR accuracy manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "requiredDocumentTypes",
    "requiredSlices",
    "requiredDocumentSlices",
    "thresholds",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "requiredDocumentTypes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/documentType"
      },
      "allOf": [
        { "contains": { "const": "pan" } },
        { "contains": { "const": "aadhaar" } },
        { "contains": { "const": "driving_licence" } },
        { "contains": { "const": "voter_id" } },
        { "contains": { "const": "nrega_job_card" } },
        { "contains": { "const": "npr_letter" } }
      ]
    },
    "requiredSlices": {
      "$ref": "#/$defs/requiredSliceMap"
    },
    "requiredDocumentSlices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pan",
        "aadhaar",
        "driving_licence",
        "voter_id",
        "nrega_job_card",
        "npr_letter"
      ],
      "properties": {
        "pan": { "$ref": "#/$defs/requiredSliceMap" },
        "aadhaar": { "$ref": "#/$defs/requiredSliceMap" },
        "driving_licence": { "$ref": "#/$defs/requiredSliceMap" },
        "voter_id": { "$ref": "#/$defs/requiredSliceMap" },
        "nrega_job_card": { "$ref": "#/$defs/requiredSliceMap" },
        "npr_letter": { "$ref": "#/$defs/requiredSliceMap" }
      }
    },
    "thresholds": {
      "$ref": "#/$defs/thresholds"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "$defs": {
    "requiredSliceMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "designFamily",
          "yearBand",
          "issuer",
          "state",
          "language",
          "script",
          "side",
          "captureType",
          "quality.resolution",
          "quality.blur",
          "quality.glare",
          "quality.rotation",
          "quality.crop",
          "quality.perspective",
          "quality.compression"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "documentType": {
      "enum": [
        "pan",
        "aadhaar",
        "driving_licence",
        "voter_id",
        "nrega_job_card",
        "npr_letter"
      ]
    },
    "thresholdRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minClassificationAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minExpectedAcceptanceRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minExactFieldAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minNormalizedFieldAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minCompleteRecordAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minNormalizedCompleteRecordAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxFalseSuccessRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxRuntimeErrorRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall"
      ],
      "properties": {
        "overall": {
          "allOf": [
            {
              "$ref": "#/$defs/thresholdRules"
            },
            {
              "required": [
                "minClassificationAccuracy",
                "minExpectedAcceptanceRate",
                "minExactFieldAccuracy",
                "minNormalizedFieldAccuracy",
                "minCompleteRecordAccuracy",
                "minNormalizedCompleteRecordAccuracy",
                "maxFalseSuccessRate",
                "maxRuntimeErrorRate"
              ]
            }
          ]
        },
        "perDocument": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "*",
              "pan",
              "aadhaar",
              "driving_licence",
              "voter_id",
              "nrega_job_card",
              "npr_letter"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/thresholdRules"
          }
        },
        "perSlice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dimensions",
            "minimumSamples",
            "rules"
          ],
          "properties": {
            "dimensions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "designFamily",
                  "yearBand",
                  "issuer",
                  "state",
                  "language",
                  "script",
                  "side",
                  "captureType",
                  "quality.resolution",
                  "quality.blur",
                  "quality.glare",
                  "quality.rotation",
                  "quality.crop",
                  "quality.perspective",
                  "quality.compression"
                ]
              }
            },
            "minimumSamples": {
              "type": "integer",
              "minimum": 1
            },
            "rules": {
              "$ref": "#/$defs/thresholdRules"
            }
          }
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "description": "Use 'national' or 'not_applicable' where appropriate."
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution",
        "blur",
        "glare",
        "rotation",
        "crop",
        "perspective",
        "compression"
      ],
      "properties": {
        "resolution": {
          "enum": ["low", "medium", "high", "native_pdf"]
        },
        "blur": {
          "enum": ["none", "mild", "severe"]
        },
        "glare": {
          "enum": ["none", "mild", "severe"]
        },
        "rotation": {
          "enum": ["upright", "minor_skew", "quarter_turn", "upside_down"]
        },
        "crop": {
          "enum": ["full", "tight", "partial"]
        },
        "perspective": {
          "enum": ["flat", "mild", "severe"]
        },
        "compression": {
          "enum": ["none", "mild", "severe"]
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "quality"
      ],
      "properties": {
        "type": {
          "enum": [
            "flatbed_scan",
            "phone_photo",
            "screenshot",
            "native_pdf",
            "photocopy",
            "other"
          ]
        },
        "quality": {
          "$ref": "#/$defs/quality"
        }
      }
    },
    "fieldValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fieldValue"
          }
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "fields",
        "requiredFields"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "classificationTarget": {
          "enum": [
            "pan",
            "aadhaar",
            "driving_licence",
            "voter_id",
            "nrega_job_card",
            "npr_letter",
            "unknown"
          ],
          "description": "Expected classifier output. Defaults to the sample documentType; use unknown for unrelated negative controls."
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fieldValue"
          }
        },
        "requiredFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accepted": {
                "const": true
              }
            },
            "required": [
              "accepted"
            ]
          },
          "then": {
            "properties": {
              "fields": {
                "minProperties": 1
              },
              "requiredFields": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset",
        "documentType",
        "designFamily",
        "yearBand",
        "issuer",
        "languages",
        "scripts",
        "side",
        "capture",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "description": "Safe path relative to the private dataset root."
        },
        "documentType": {
          "$ref": "#/$defs/documentType"
        },
        "designFamily": {
          "type": "string",
          "minLength": 1
        },
        "yearBand": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "side": {
          "enum": [
            "front",
            "back",
            "both",
            "single_page",
            "multi_page"
          ]
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
